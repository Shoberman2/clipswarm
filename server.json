{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Shoberman2/clipswarm",
  "description": "Cut clips and viral 9:16 shorts from YouTube videos and livestreams, in parallel (local yt-dlp + ffmpeg)",
  "repository": { "url": "https://github.com/Shoberman2/clipswarm", "source": "github" },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "clipswarm",
      "version": "0.1.0",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }]
    }
  ]
}
