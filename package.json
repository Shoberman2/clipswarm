{
  "name": "clipswarm",
  "version": "0.1.0",
  "description": "Parallel YouTube & livestream clipping for AI agents: viral 9:16 shorts with hook headers and word-by-word captions. MCP server + CLI.",
  "main": "dist/core.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "youtube",
    "clips",
    "yt-dlp",
    "ffmpeg",
    "agents",
    "claude",
    "shorts",
    "tiktok",
    "reels",
    "viral",
    "captions",
    "livestream",
    "opusclip-alternative"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@resvg/resvg-js": "^2.6.2",
    "opentype.js": "1.3.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/opentype.js": "^1.3.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "bin": {
    "clipswarm": "dist/cli.js"
  },
  "types": "dist/core.d.ts",
  "files": [
    "dist",
    "assets",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shoberman2/clipswarm.git"
  },
  "homepage": "https://github.com/Shoberman2/clipswarm#readme",
  "bugs": {
    "url": "https://github.com/Shoberman2/clipswarm/issues"
  },
  "mcpName": "io.github.Shoberman2/clipswarm"
}
